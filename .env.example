# Environment Mode (development, production, testing)
APP_ENV=development

# Database Configuration (SQLite default, portable to PostgreSQL)
DATABASE_URL=sqlite:///./storage/database/faculty_workload.db

# LLM Provider Configuration ("ollama" or "offline")
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
LLM_TIMEOUT_SECONDS=30

# Vector Embeddings & RAG Configuration ("sentence-transformers" or "tfidf")
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_STORE_PATH=./storage/vector_store
DOCUMENTS_DIR=./storage/documents

# Dataset Source Path
DATASET_PATH=./data/faculty_workload_dummy_dataset.xlsx

# Security & Demo Authentication Settings
DEMO_AUTH_ENABLED=true
JWT_SECRET_KEY=insecure-demo-secret-key-do-not-use-in-production-12345
LOG_LEVEL=INFO

